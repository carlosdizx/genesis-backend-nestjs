NODE_ENV=development
PORT=3000
LOG_LEVELS=log,error,warn,debug,verbose,fatal

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_LOGGING=false

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

OBSERVE_APP_KEY=changeme
OBSERVE_APP_SECRET=changeme
OBSERVE_SERVICE_ID=changeme

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=changeme@gmail.com
SMTP_PASSWORD=changeme

KAFKA_ADVERTISED_HOST=localhost
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=genesis-app
KAFKA_CONSUMER_GROUP=genesis-consumer-group
KAFKA_STREAM_TOPIC=genesis.stream.events
KAFKA_FAILURE_TOPIC=genesis.stream.failures
KAFKA_UI_PORT=8080
